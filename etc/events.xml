<?xml version="1.0"?>
<!--
    Global-area event subscriptions.

    sales_order_save_after fires once per Magento order persistence, in BOTH the
    admin and frontend areas. We subscribe ONLY here (not sales_order_place_after,
    which fires before the order has a DB id; and not checkout_submit_all_after,
    which is skipped by some third-party checkouts). The observer applies a state
    transition gate so it acts at most once per order lifecycle.

    sales_order_place_after stores the shopper's browser identity (AxiTrace visitor and
    session ids, IP, User-Agent, ad platform browser ids, persisted click ids) on the
    order. It fires inside Order::place(), in the request that places the order, and
    OrderService saves the order right after, so the value is persisted with it. Only a
    request from the shopper's own browser is read; see Model/Identity.

    sales_order_creditmemo_save_after and order_cancel_after report refunds and
    cancellations to AxiTrace POST /v1/refund. Both are no-ops unless the optional
    AxiTrace secret key is configured; see Model/Refund/RefundSender.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_place_after">
        <observer name="axitrace_tracking_capture_browser_identity"
                  instance="AxiTrace\Tracking\Observer\CaptureBrowserIdentityObserver"/>
    </event>
    <event name="sales_order_save_after">
        <observer name="axitrace_tracking_order_state_transition"
                  instance="AxiTrace\Tracking\Observer\OrderStateTransitionObserver"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="axitrace_tracking_creditmemo_refund"
                  instance="AxiTrace\Tracking\Observer\CreditmemoRefundObserver"/>
    </event>
    <event name="order_cancel_after">
        <observer name="axitrace_tracking_order_cancel"
                  instance="AxiTrace\Tracking\Observer\OrderCancelObserver"/>
    </event>
</config>
