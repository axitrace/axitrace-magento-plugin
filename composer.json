{
    "name": "axitrace/module-tracking",
    "description": "AxiTrace server-side tracking for Magento 2 / Adobe Commerce — Facebook CAPI, TikTok Events API, Google Ads offline conversions, GA4. Free module; requires an AxiTrace SaaS account at axitrace.com.",
    "type": "magento2-module",
    "license": "MIT",
    "homepage": "https://axitrace.com/integrations/magento",
    "support": {
        "email": "info@axitrace.com",
        "docs": "https://axitrace.com/docs/integrations/magento",
        "issues": "https://github.com/axitrace/axitrace-magento-plugin/issues"
    },
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "ext-json": "*",
        "ext-curl": "*",
        "magento/framework": "^103.0",
        "magento/module-sales": "^103.0 || ^104.0",
        "magento/module-catalog": "^103.0 || ^104.0",
        "magento/module-checkout": "^100.0",
        "magento/module-config": "^101.0"
    },
    "require-dev": {
        "magento/magento-coding-standard": "^40.0",
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "AxiTrace\\Tracking\\": ""
        }
    }
}
