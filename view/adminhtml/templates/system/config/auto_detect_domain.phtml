<?php
/**
 * @var \AxiTrace\Tracking\Block\Adminhtml\System\Config\AutoDetectDomainButton $block
 */
$htmlId = (string) $block->getData('html_id');
$ajaxUrl = (string) $block->getData('ajax_url');
$label = (string) $block->getData('button_label');
?>
<button type="button" id="<?= $block->escapeHtmlAttr($htmlId) ?>_btn" class="action-default scalable">
    <span><?= $block->escapeHtml($label) ?></span>
</button>
<div id="<?= $block->escapeHtmlAttr($htmlId) ?>_status" style="margin-top:6px;font-size:12px;color:#555"></div>

<script>
    require(['jquery'], function ($) {
        'use strict';
        var btn = document.getElementById('<?= $block->escapeJs($htmlId) ?>_btn');
        var status = document.getElementById('<?= $block->escapeJs($htmlId) ?>_status');
        if (!btn || !status) {
            return;
        }
        btn.addEventListener('click', function () {
            var keyField = document.getElementById('axitrace_general_workspace_public_key');
            var domainField = document.getElementById('axitrace_general_tracking_domain');
            var formKey = (window.FORM_KEY || (window.formKey ? window.formKey : ''));

            status.style.color = '#555';
            status.textContent = 'Detecting tracking domain...';

            $.ajax({
                url: '<?= $block->escapeJs($ajaxUrl) ?>',
                type: 'POST',
                dataType: 'json',
                data: {
                    workspace_public_key: keyField ? keyField.value : '',
                    form_key: formKey
                }
            }).done(function (resp) {
                if (resp && resp.success && resp.domain) {
                    if (domainField) {
                        domainField.value = resp.domain;
                    }
                    status.style.color = '#28a745';
                    status.textContent = 'Tracking domain set to ' + resp.domain;
                } else {
                    status.style.color = '#dc3545';
                    status.textContent = (resp && resp.message) ? resp.message : 'No tracking domain detected.';
                }
            }).fail(function () {
                status.style.color = '#dc3545';
                status.textContent = 'Auto-detect request failed. Please try again.';
            });
        });
    });
</script>
