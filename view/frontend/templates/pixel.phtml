<?php
/**
 * AxiTrace storefront pixel — Luma theme.
 *
 * Writes window.axitraceConfig from the StorefrontConfig view model and lazy-loads
 * the AxiTrace SDK. Page-type hooks (product, category, cart, checkout, payment)
 * are dispatched from the switch/listeners below once the SDK boots.
 *
 * @var \AxiTrace\Tracking\Block\Pixel $block
 */

/** @var \AxiTrace\Tracking\ViewModel\StorefrontConfig $viewModel */
$viewModel = $block->getData('view_model');
if (!$viewModel || !$viewModel->isEnabled()) {
    return;
}

$config = $viewModel->getInlineConfig();
$configJson = (string) json_encode($config, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);

$productPayload = null;
$productViewModel = $block->getData('product_view_model');
if ($productViewModel instanceof \AxiTrace\Tracking\ViewModel\ProductContext) {
    $productPayload = $productViewModel->getProductPayload();
}

$categoryPayload = null;
$categoryViewModel = $block->getData('category_view_model');
if ($categoryViewModel instanceof \AxiTrace\Tracking\ViewModel\CategoryContext) {
    $categoryPayload = $categoryViewModel->getCategoryPayload();
}

$checkoutPayload = null;
$checkoutViewModel = $block->getData('checkout_view_model');
if ($checkoutViewModel instanceof \AxiTrace\Tracking\ViewModel\CheckoutContext) {
    $checkoutPayload = $checkoutViewModel->getCheckoutPayload();
}

$extraJson = (string) json_encode(
    array_filter([
        'product'  => $productPayload ?: null,
        'category' => $categoryPayload ?: null,
        'checkout' => $checkoutPayload ?: null,
    ]),
    JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES
);

$trackingDomain = (string) $config['trackingDomain'];
$sdkUrl = 'https://' . htmlspecialchars($trackingDomain, ENT_QUOTES, 'UTF-8') . '/axitrack.js';
?>
<script>
    (function () {
        'use strict';
        window.axitraceConfig = <?= /* @noEscape */ $configJson ?>;
        window.axitracePageContext = <?= /* @noEscape */ $extraJson ?>;
    })();
</script>
<script defer src="<?= /* @noEscape */ $sdkUrl ?>"></script>
<script>
    (function () {
        'use strict';
        function waitFor(cb) {
            if (window.Axitrace && typeof window.Axitrace.init === 'function') { cb(); return; }
            setTimeout(function () { waitFor(cb); }, 50);
        }
        waitFor(function () {
            var cfg = window.axitraceConfig || {};
            if (!cfg.publicKey) { return; }
            var ctx = window.axitracePageContext || {};
            var toggles = cfg.toggles || {};
            var tracker;
            try {
                tracker = window.Axitrace.init({
                    publicKey: cfg.publicKey,
                    apiUrl:    cfg.apiBaseUrl || ('https://' + cfg.trackingDomain),
                    debug:     !!cfg.debug
                });
            } catch (e) { return; }
            if (!tracker || typeof tracker.track !== 'function') { return; }

            switch (cfg.pageType) {
                case 'product':
                    if (toggles.view_content !== false && ctx.product) {
                        tracker.track('product.view', {
                            sku: ctx.product.sku,
                            productId: ctx.product.productId,
                            name: ctx.product.name,
                            price: ctx.product.price,
                            currency: ctx.product.currency,
                            products: [ctx.product],
                            source: 'magento'
                        });
                    }
                    break;
                case 'category':
                    if (toggles.view_category !== false) {
                        tracker.track('page.view', {
                            pageType: 'category',
                            category: ctx.category || null,
                            source: 'magento'
                        });
                    }
                    break;
                case 'checkout':
                    if (toggles.begin_checkout !== false) {
                        var checkoutCtx = ctx.checkout || {};
                        tracker.track('begin_checkout', {
                            value: checkoutCtx.value,
                            currency: checkoutCtx.currency,
                            itemCount: checkoutCtx.itemCount,
                            source: 'magento'
                        });
                    }
                    break;
                case 'confirmation':
                    break;
                default:
                    if (toggles.page_view !== false && cfg.pageType) {
                        tracker.track('page.view', { pageType: cfg.pageType, source: 'magento' });
                    }
                    break;
            }

            if (cfg.pageType === 'checkout' && toggles.add_payment_info !== false) {
                var paymentInfoFired = false;
                var firePaymentInfo = function () {
                    if (paymentInfoFired) { return; }
                    paymentInfoFired = true;
                    var checkoutCtx = ctx.checkout || {};
                    tracker.track('add_payment_info', {
                        value: checkoutCtx.value,
                        currency: checkoutCtx.currency,
                        itemCount: checkoutCtx.itemCount,
                        source: 'magento'
                    });
                };
                // Primary signal: Magento's checkout SPA reflects the active step in
                // the URL hash (#shipping / #payment) via
                // Magento_Checkout/js/model/step-navigator. This fires on every
                // shop regardless of how many payment methods are configured —
                // unlike a radio "change" listener alone, which never fires when
                // only one payment method exists (Magento auto-selects it without
                // a user interaction event).
                if (window.location.hash === '#payment') {
                    firePaymentInfo();
                }
                window.addEventListener('hashchange', function () {
                    if (window.location.hash === '#payment') {
                        firePaymentInfo();
                    }
                }, false);
                // Fallback: some checkout customizations (custom payment UI
                // components, one-step checkout extensions) don't sync
                // step-navigator to the URL hash. A delegated change listener on
                // the payment method radios catches those too.
                document.addEventListener('change', function (e) {
                    var t = e.target;
                    if (!t || !t.name || t.name.indexOf('payment[method]') !== 0) { return; }
                    firePaymentInfo();
                }, true);
            }

            if (toggles.add_to_cart !== false) {
                document.addEventListener('click', function (e) {
                    var btn = e.target && e.target.closest ? e.target.closest('button.tocart, button.action.tocart') : null;
                    if (!btn || !ctx.product) { return; }
                    tracker.track('product.addToCart', {
                        sku: ctx.product.sku,
                        productId: ctx.product.productId,
                        name: ctx.product.name,
                        price: ctx.product.price,
                        currency: ctx.product.currency,
                        quantity: 1,
                        products: [ctx.product],
                        source: 'magento'
                    });
                }, false);
            }
        });
    })();
</script>
