<?xml version="1.0"?>
<!--
    Checkout page (SPA): exposes CheckoutContext so pixel.phtml can fire
    `begin_checkout` with the real cart value/currency/item count.

    Magento's one-page checkout renders shipping and payment as client-side
    Knockout steps inside this single controller action — there is no second
    full-page navigation for the payment step, so `add_payment_info` is fired
    by a JS listener inside pixel.phtml (URL-hash step detection + a payment
    method change fallback), not a second layout hook.

    Layout XML is merged from every active module regardless of the storefront
    theme, so this single file also wires the block argument for stores running
    the axitrace/module-tracking-hyva compat module — no separate Hyva layout
    file is needed for this handle.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="axitrace.pixel">
            <arguments>
                <argument name="checkout_view_model" xsi:type="object">AxiTrace\Tracking\ViewModel\CheckoutContext</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
