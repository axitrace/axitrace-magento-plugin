<?xml version="1.0"?>
<!--
    Category page: exposes CategoryContext so pixel.phtml can fire view_category.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="axitrace.pixel">
            <arguments>
                <argument name="category_view_model" xsi:type="object">AxiTrace\Tracking\ViewModel\CategoryContext</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
